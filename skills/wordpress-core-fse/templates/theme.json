{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "1200px",
      "wideSize": "1360px"
    },
    "color": {
      "custom": true,
      "defaultPalette": false,
      "palette": [
        { "slug": "brand-primary", "color": "#0E2E35", "name": "Deep Primary" },
        { "slug": "brand-accent",  "color": "#E0281D", "name": "Accent Torch" },
        { "slug": "text-main",     "color": "#152023", "name": "Text Main" },
        { "slug": "text-muted",    "color": "#2A4F5A", "name": "Text Muted" },
        { "slug": "canvas-bg",     "color": "#F4FAFB", "name": "Canvas Background" },
        { "slug": "pure-white",    "color": "#FFFFFF", "name": "Pure White" }
      ]
    },
    "typography": {
      "customFontSize": true,
      "fluid": true,
      "fontFamilies": [
        {
          "fontFamily": "'Playfair Display', Georgia, serif",
          "name": "Playfair Display",
          "slug": "display"
        },
        {
          "fontFamily": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
          "name": "Inter",
          "slug": "ui"
        }
      ],
      "fontSizes": [
        { "slug": "xs",   "size": "12px", "name": "Extra Small (12px)" },
        { "slug": "sm",   "size": "14px", "name": "Small (14px)" },
        { "slug": "base", "size": "16px", "name": "Base (16px)" },
        { "slug": "lg",   "size": "18px", "name": "Large (18px)" },
        { "slug": "xl",   "size": "20px", "name": "Extra Large (20px)" },
        { "slug": "2xl",  "size": "24px", "name": "2X Large (24px)" },
        { "slug": "3xl",  "size": "30px", "name": "3X Large (30px)" },
        { "slug": "4xl",  "size": "36px", "name": "4X Large (36px)" },
        { "slug": "5xl",  "size": "48px", "name": "5X Large (48px)" }
      ]
    },
    "spacing": {
      "defaultSpacingSizes": false,
      "customSpacingSize": true,
      "spacingScale": { "steps": 0 },
      "spacingSizes": [
        { "name": "8px (1 unit)",   "size": "8px",  "slug": "10" },
        { "name": "16px (2 units)", "size": "16px", "slug": "20" },
        { "name": "24px (3 units)", "size": "24px", "slug": "30" },
        { "name": "32px (4 units)", "size": "32px", "slug": "40" },
        { "name": "40px (5 units)", "size": "40px", "slug": "50" },
        { "name": "48px (6 units)", "size": "48px", "slug": "60" },
        { "name": "56px (7 units)", "size": "56px", "slug": "70" },
        { "name": "64px (8 units)", "size": "64px", "slug": "80" },
        { "name": "80px (10 units)", "size": "80px", "slug": "100" },
        { "name": "96px (12 units)", "size": "96px", "slug": "120" }
      ],
      "units": ["px", "rem", "%", "vw", "vh"]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--canvas-bg)",
      "text": "var(--wp--preset--color--text-muted)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--ui)",
      "fontSize": "var(--wp--preset--font-size--base)",
      "lineHeight": "1.6"
    }
  }
}
